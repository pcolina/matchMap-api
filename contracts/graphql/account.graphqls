type User {
  id: ID!
  email: String!
  username: String!
  displayName: String!
  createdAt: String!
}

input RegisterInput {
  email: String!
  username: String!
  displayName: String!
  password: String!
}

type Mutation {
  register(input: RegisterInput!): User!
}

extend type Query {
  me: User!
}
